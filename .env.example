# Copy this file to .env and fill values locally.
# Never commit real API keys.

VITE_AI_PROVIDER=mock
VITE_ASR_MODE=mock
VITE_ASR_MODEL=mock-streaming-asr
VITE_TRANSLATION_MODEL=mock-bilingual-translator

# Recommended real-use setup: one Alibaba Cloud Model Studio / DashScope key for ASR + translation.
# VITE_AI_PROVIDER=aliyun
# VITE_ASR_MODE=provider
# REALTIME_ASR_PROVIDER=aliyun
# REALTIME_ASR_MODEL=fun-asr-realtime
# REALTIME_ASR_BASE_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
# TRANSLATION_PROVIDER=aliyun
# TRANSLATION_MODEL=qwen-plus
# FAST_DRAFT_MODEL=qwen-turbo
# FAST_DRAFT_STREAMING=true
# TRANSLATION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_API_KEY=your_dashscope_api_key

# Realtime ASR provider shell. Keep provider keys in this local .env file only.
REALTIME_ASR_PROVIDER=mock
REALTIME_ASR_MODEL=gpt-4o-mini-transcribe
REALTIME_ASR_BASE_URL=https://api.openai.com/v1

# Translation provider shell. OpenAI is the default complete path; DeepSeek is translation-only.
TRANSLATION_PROVIDER=mock
TRANSLATION_MODEL=mock-bilingual-translator
TRANSLATION_BASE_URL=https://api.openai.com/v1

# Optional realtime tuning. Lower values can reduce perceived latency but may increase provider pressure.
VITE_AUDIO_CHUNK_DURATION_MS=160
VITE_PROVIDER_ASR_POLL_INTERVAL_MS=750
VITE_TRANSLATION_MIN_PARTIAL_CHARACTERS=10
VITE_TRANSLATION_MIN_PARTIAL_WORDS=3
VITE_TRANSLATION_PARTIAL_DEBOUNCE_MS=120
VITE_VISIBLE_LATENCY_WARNING_MS=1500

# Optional subtitle refinement. Defaults reuse TRANSLATION_PROVIDER and TRANSLATION_MODEL.
# REFINEMENT_PROVIDER=aliyun
# REFINEMENT_MODEL=qwen-plus
# REFINEMENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# To try provider-backed OpenAI file transcription, translation, and realtime session shell:
# VITE_AI_PROVIDER=openai
# VITE_ASR_MODE=provider
# REALTIME_ASR_PROVIDER=openai
# REALTIME_ASR_MODEL=gpt-4o-mini-transcribe
# TRANSLATION_PROVIDER=openai
# TRANSLATION_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=your_openai_api_key

# Optional DeepSeek-compatible translation-only provider:
# TRANSLATION_PROVIDER=deepseek
# TRANSLATION_MODEL=deepseek-chat
# TRANSLATION_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=your_deepseek_api_key

# Optional custom OpenAI-compatible translation provider. For DashScope/Qwen, prefer TRANSLATION_PROVIDER=aliyun.
# CUSTOM_TRANSLATION_API_KEY=your_custom_translation_api_key

# Optional cloud TTS placeholder for future updates.
TTS_MODEL=
